# LearnQuest (бэкенд) — настройки. Скопируй в ".env" (start.bat сделает это сам). Пустые значения игнорируются, кавычки не нужны.
# В облаке (Amvera) те же имена задаются в разделе «Переменные» проекта; ключи и токены — как «Секреты».

# ---------- ИИ-модели (цепочка: DeepSeek → свой провайдер → OpenRouter) ----------
# DeepSeek напрямую: ключ с https://platform.deepseek.com (платный, очень дешёвый; на счёте должен быть баланс)
DEEPSEEK_API_KEY=
# Ключ OpenRouter (https://openrouter.ai/keys, бесплатно, карта не нужна): запасные бесплатные модели (~50 запросов/сутки).
# В https://openrouter.ai/settings/privacy включи "Enable free endpoints that may publish prompts".
OPENROUTER_API_KEY=
# Необязательно: разрешить дешёвые ПЛАТНЫЕ модели DeepSeek через OpenRouter (1 = да; нужен баланс на OpenRouter)
LLM_ALLOW_PAID=
# Необязательно: свой OpenAI-совместимый провайдер (Cerebras, Groq…), пробуется после DeepSeek
LLM_BASE_URL=
LLM_API_KEY=
LLM_CUSTOM_MODELS=
# Необязательно: свой список моделей OpenRouter через запятую (по умолчанию — автоподбор бесплатных)
LLM_MODELS=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# 0 — не запускать бота в этом экземпляре (если бот уже работает в облаке с тем же токеном — на ПК поставь 0)
TELEGRAM_ENABLED=1

# ---------- Безопасность и доступ ----------
# Секрет подписи JWT-токенов. В облаке ОБЯЗАТЕЛЬНО задай длинную случайную строку (иначе она сгенерируется и сохранится в базе).
JWT_SECRET=
# Адреса фронтенда через запятую (CORS). Для GitHub Pages: https://ashubinov.github.io
CORS_ORIGINS=
# Логин администратора: у него есть настройки ключей, публикация и импорт каталога. Если пусто — админ это первый зарегистрированный.
ADMIN_USERNAME=
# Регистрация новых пользователей: 1 — открыта, 0 — закрыта (после того как друзья зарегистрировались)
ALLOW_REGISTRATION=1
# Лимиты на пользователя (защита платного ключа ИИ)
MAX_COURSES_PER_USER=12
MAX_NEW_COURSES_PER_DAY=4

# ---------- Запуск ----------
# Папка данных. Локально ./data; в Amvera задаётся автоматически (/data).
DATA_DIR=
# 127.0.0.1 — только этот ПК; 0.0.0.0 — вся домашняя сеть
HOST=127.0.0.1
PORT=8000
