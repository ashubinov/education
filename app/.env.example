# LearnQuest — настройки. Скопируй этот файл в ".env" (start.bat сделает это сам) и впиши значения.
# Строки с пустым значением игнорируются. Кавычки не нужны.

# Ключ OpenRouter (https://openrouter.ai/keys, регистрация бесплатная, карта не нужна).
# Приложение само подбирает лучшие БЕСПЛАТНЫЕ модели каталога (лимит ~50 запросов в сутки без пополнения баланса).
# Важно: в https://openrouter.ai/settings/privacy включи "Enable free endpoints that may publish prompts",
# иначе бесплатные модели вернут ошибку 404 "No endpoints found".
OPENROUTER_API_KEY=

# Необязательно: разрешить дешёвые ПЛАТНЫЕ модели DeepSeek через OpenRouter (≈5–15 центов за курс, нужен баланс). 1 = да.
LLM_ALLOW_PAID=

# Необязательно: свой OpenAI-совместимый провайдер — пробуется ПЕРВЫМ, затем OpenRouter.
# DeepSeek напрямую:  LLM_BASE_URL=https://api.deepseek.com            LLM_CUSTOM_MODELS=deepseek-chat
# Cerebras (Qwen):    LLM_BASE_URL=https://api.cerebras.ai/v1          LLM_CUSTOM_MODELS=qwen-3-235b-a22b-instruct-2507
# Groq (Qwen):        LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_CUSTOM_MODELS=qwen/qwen3-32b
LLM_BASE_URL=
LLM_API_KEY=
LLM_CUSTOM_MODELS=

# Токен Telegram-бота от @BotFather (команда /newbot). Нужен только для обучения в Telegram.
TELEGRAM_BOT_TOKEN=

# Необязательно: свой список моделей OpenRouter через запятую (по приоритету). По умолчанию — автоподбор.
# Пример: nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
LLM_MODELS=

# Адрес и порт сервера. 127.0.0.1 — доступ только с этого ПК.
# 0.0.0.0 — открыть доступ из домашней сети (например, с телефона по адресу http://IP-компьютера:8000).
HOST=127.0.0.1
PORT=8000
